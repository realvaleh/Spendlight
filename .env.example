# Upstream OpenAI-compatible API
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1

# Spendlight
SPENDLIGHT_HOST=127.0.0.1
SPENDLIGHT_PORT=8787
SPENDLIGHT_DB=./data/spendlight.db
SPENDLIGHT_CONFIG=./spendlight.config.json

# Optional env budget overrides (USD). Config file wins unless these are set.
SPENDLIGHT_SOFT_BUDGET_USD=10
SPENDLIGHT_HARD_BUDGET_USD=25

# Upstream OpenAI-compatible API
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1

# Spendlight — keep the default bind on localhost. Do not publish this port.
SPENDLIGHT_HOST=127.0.0.1
SPENDLIGHT_PORT=8787
SPENDLIGHT_DB=./data/spendlight.db
SPENDLIGHT_CONFIG=./spendlight.config.json

# Optional env budget overrides (USD). Config file wins unless these are set.
SPENDLIGHT_SOFT_BUDGET_USD=10
SPENDLIGHT_HARD_BUDGET_USD=25

# Optional calendar window. Omit these to keep a lifetime cap.
# Uncomment one period. day resets at local midnight; week resets at local midnight on Monday (ISO, Monday–Sunday); month resets at local midnight on the 1st.
# SPENDLIGHT_BUDGET_PERIOD=day
# SPENDLIGHT_BUDGET_PERIOD=week
# SPENDLIGHT_BUDGET_PERIOD=month
# SPENDLIGHT_BUDGET_TIMEZONE=America/New_York
